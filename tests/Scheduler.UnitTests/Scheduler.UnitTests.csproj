<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast tests with no database: cron parser, schedule calculator, retry policy, dependency cycles, validation, password hashing (NFR-22). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scheduler.Domain\Scheduler.Domain.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Application\Scheduler.Application.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Engine\Scheduler.Engine.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Infrastructure\Scheduler.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Modules.Security\Scheduler.Modules.Security.csproj" />
    <ProjectReference Include="..\..\demos\DemoApps.MaintenanceAgent\DemoApps.MaintenanceAgent.csproj" />
    <ProjectReference Include="..\..\demos\DemoApps.MaintenanceAgentConnector\DemoApps.MaintenanceAgentConnector.csproj" />
    <ProjectReference Include="..\..\demos\DemoApps.InventoryMonitor\DemoApps.InventoryMonitor.csproj" />
  </ItemGroup>

</Project>
