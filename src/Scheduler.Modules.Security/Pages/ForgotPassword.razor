@page "/login/forgot-password"
@inject UserManagement Users
@inject IAuditLog Audit

@* "Forgot password": everything runs locally without email, so the user proves who they are with their recovery code.
   Without a code, an administrator resets the password on the Users page. *@
<div class="login-screen">
    <div class="card login-card">
        <h1>Forgot password</h1>

        @if (_result is { Succeeded: true, RecoveryCode: { } newCode })
        {
            <div class="banner banner-success" role="status">Your password has been changed. Your old recovery code no longer works.</div>
            <RecoveryCodeNotice Code="@newCode" />
            <a class="btn btn-primary" href="login">Sign in</a>
        }
        else
        {
            <p class="muted">
                Enter your username, the recovery code you wrote down when your account was created, and a new password.
                If you have no recovery code, ask an administrator to reset your password.
            </p>
            <form @onsubmit="RecoverAsync">
                <div class="field">
                    <label for="rec-username">Username</label>
                    <input id="rec-username" @bind="_username" autocomplete="username" maxlength="50" />
                </div>
                <div class="field">
                    <label for="rec-code">Recovery code</label>
                    <input id="rec-code" @bind="_code" autocomplete="off" spellcheck="false" maxlength="40" placeholder="XXXX-XXXX-XXXX-XXXX" />
                </div>
                <div class="field">
                    <label for="rec-password">New password</label>
                    <input id="rec-password" type="password" @bind="_password" autocomplete="new-password" />
                    <span class="hint">@PasswordPolicy.Description</span>
                    <FieldError Result="_result" Field="Password" />
                </div>
                <div class="field">
                    <label for="rec-confirmation">Confirm new password</label>
                    <input id="rec-confirmation" type="password" @bind="_confirmation" autocomplete="new-password" />
                    <FieldError Result="_result" Field="Confirmation" />
                </div>
                <ErrorBanner Result="_result" />
                <button class="btn btn-primary" type="submit" disabled="@_busy">Set new password</button>
            </form>
            <div class="login-links"><a href="login">Back to sign in</a></div>
        }
    </div>
</div>

@code {
    private string _username = "";
    private string _code = "";
    private string _password = "";
    private string _confirmation = "";
    private UserActionResult? _result;
    private bool _busy;

    private async Task RecoverAsync()
    {
        _busy = true;
        try
        {
            _result = await Users.RecoverPasswordAsync(_username, _code, _password, _confirmation);
            if (_result.Succeeded)
            {
                _code = _password = _confirmation = "";
            }
        }
        catch (Exception)
        {
            await Audit.RecordAsync("PasswordRecoveryUnavailable", "A password recovery attempt could not be completed because account storage was unavailable.",
                "Login and Security");
            _result = UserActionResult.Fail("The password could not be changed because the database cannot be reached.");
        }
        finally
        {
            _busy = false;
        }
    }
}
