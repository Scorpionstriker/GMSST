@page "/login/register"
@inject UserManagement Users
@inject IAuditLog Audit

@* Self-registration. The account is an inactive Viewer until an administrator activates it on the Users page. *@
<div class="login-screen">
    <div class="card login-card">
        <h1>Register</h1>

        @if (_result is { Succeeded: true, RecoveryCode: { } newCode })
        {
            <div class="banner banner-success" role="status">
                Your account <strong>@_registered</strong> was created. An administrator must activate it before you can sign in.
            </div>
            <RecoveryCodeNotice Code="@newCode" />
            <a class="btn btn-primary" href="login">Back to sign in</a>
        }
        else
        {
            <p class="muted">Ask for an account. It can view the scheduler once an administrator has activated it.</p>
            <form @onsubmit="RegisterAsync">
                <div class="field">
                    <label for="reg-username">Username</label>
                    <input id="reg-username" @bind="_username" autocomplete="username" maxlength="50" />
                    <FieldError Result="_result" Field="Username" />
                </div>
                <div class="field">
                    <label for="reg-password">Password</label>
                    <input id="reg-password" type="password" @bind="_password" autocomplete="new-password" />
                    <span class="hint">@PasswordPolicy.Description</span>
                    <FieldError Result="_result" Field="Password" />
                </div>
                <div class="field">
                    <label for="reg-confirmation">Confirm password</label>
                    <input id="reg-confirmation" type="password" @bind="_confirmation" autocomplete="new-password" />
                    <FieldError Result="_result" Field="Confirmation" />
                </div>
                <ErrorBanner Result="_result" />
                <button class="btn btn-primary" type="submit" disabled="@_busy">Register</button>
            </form>
            <div class="login-links"><a href="login">Back to sign in</a></div>
        }
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string _confirmation = "";
    private string? _registered;
    private UserActionResult? _result;
    private bool _busy;

    private async Task RegisterAsync()
    {
        _busy = true;
        try
        {
            _result = await Users.RegisterAsync(_username, _password, _confirmation);
            if (_result.Succeeded)
            {
                _registered = _username.Trim();
                _password = _confirmation = "";
            }
        }
        catch (Exception)
        {
            await Audit.RecordAsync("RegistrationUnavailable", "A registration attempt could not be completed because account storage was unavailable.",
                "Login and Security");
            _result = UserActionResult.Fail("Registering failed because the database cannot be reached.");
        }
        finally
        {
            _busy = false;
        }
    }
}
