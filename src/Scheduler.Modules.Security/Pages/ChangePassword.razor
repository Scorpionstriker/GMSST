@page "/account/password"
@inject UserManagement Users

<div class="page-header">
    <h1>Change password</h1>
</div>

<div class="card narrow">
    <form @onsubmit="SaveAsync">
        <div class="field">
            <label for="current">Current password</label>
            <input id="current" type="password" @bind="_current" autocomplete="current-password" />
            <FieldError Result="_result" Field="Current" />
        </div>
        <div class="field">
            <label for="password">New password</label>
            <input id="password" type="password" @bind="_password" autocomplete="new-password" />
            <span class="hint">@PasswordPolicy.Description</span>
            <FieldError Result="_result" Field="Password" />
        </div>
        <div class="field">
            <label for="confirmation">Confirm new password</label>
            <input id="confirmation" type="password" @bind="_confirmation" autocomplete="new-password" />
            <FieldError Result="_result" Field="Confirmation" />
        </div>
        @if (_result is { Succeeded: false, Field: null })
        {
            <div class="banner banner-error" role="alert">@_result.Error</div>
        }
        @if (_saved)
        {
            <div class="banner banner-success" role="status">Your password has been changed.</div>
        }
        <button class="btn btn-primary" type="submit">Change password</button>
    </form>
</div>

<div class="card narrow">
    <h2>Recovery code</h2>
    <p class="muted">
        The recovery code lets you set a new password on the Login page with "Forgot password?" if you forget yours.
        @(_hasCode ? "You have a recovery code. Creating a new one makes the old one stop working." : "You have no recovery code yet.")
    </p>
    @if (_codeResult is { Succeeded: true, RecoveryCode: { } newCode })
    {
        <RecoveryCodeNotice Code="@newCode" />
    }
    else
    {
        <form @onsubmit="CreateCodeAsync">
            <div class="field">
                <label for="code-current">Current password</label>
                <input id="code-current" type="password" @bind="_codePassword" autocomplete="current-password" />
                <FieldError Result="_codeResult" Field="Current" />
            </div>
            <ErrorBanner Result="_codeResult" />
            <button class="btn" type="submit">Create a new recovery code</button>
        </form>
    }
</div>

@code {
    private string _current = "";
    private string _password = "";
    private string _confirmation = "";
    private UserActionResult? _result;
    private bool _saved;
    private bool _hasCode;
    private string _codePassword = "";
    private UserActionResult? _codeResult;

    protected override async Task OnInitializedAsync() => _hasCode = await Users.HasRecoveryCodeAsync();

    private async Task CreateCodeAsync()
    {
        _codeResult = await Users.CreateOwnRecoveryCodeAsync(_codePassword);
        _codePassword = "";
        _hasCode = _hasCode || _codeResult.Succeeded;
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _result = await Users.ChangeOwnPasswordAsync(_current, _password, _confirmation);
        if (_result.Succeeded)
        {
            _saved = true;
            _current = _password = _confirmation = "";
        }
    }
}
