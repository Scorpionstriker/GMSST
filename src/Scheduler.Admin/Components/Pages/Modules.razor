@page "/modules"
@using Scheduler.Application.Tasks
@inject SchedulerHost Host
@inject IQueryHandler<GetTaskTypesQuery, IReadOnlyList<TaskTypeInfo>> GetTaskTypes
@inject IEnumerable<ISchedulerModule> ModuleList

<div class="page-header"><h1>Modules</h1></div>
<p class="muted">The modules loaded into this application, the pages they add and the task types each one provides. To remove a module, take it out of
    ModuleCatalog.cs and remove its project reference; see Help.</p>

<div class="card">
    <h2>Loaded modules</h2>
    @if (Host.Modules.Count == 0)
    {
        <p class="muted">No modules are loaded. The scheduler still runs its built-in tasks.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Module</th><th>Pages</th><th>Assembly</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var module in Host.Modules)
                {
                    <tr>
                        <td><strong>@module.Name</strong><div class="hint">@module.Description</div></td>
                        <td>
                            @* WP-8b (F-18): the menu entries the module adds, with links. *@
                            @{ var items = MenuItemsOf(module.Name); }
                            @if (items.Count == 0)
                            {
                                <span class="muted">None</span>
                            }
                            @foreach (var item in items)
                            {
                                <div>
                                    <a href="@item.Route.TrimStart('/')">@item.Title</a>
                                    <span class="hint">@(item.Group ?? "Modules")@(item.AdministratorOnly ? " · administrators" : "")</span>
                                </div>
                            }
                        </td>
                        <td class="mono">@module.Assembly</td>
                        <td>
                            @if (module.Initialized)
                            {
                                <StatusBadge Text="Loaded" Tone="success" />
                            }
                            else
                            {
                                <StatusBadge Text="Failed to start" Tone="danger" />
                                <div class="field-error">@module.Error</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2>Task types</h2>
    <table class="table">
        <thead><tr><th>Task type</th><th>Name</th><th>Provided by</th><th>Description</th></tr></thead>
        <tbody>
            @foreach (var type in _types.OrderBy(t => t.Assembly.GetName().Name).ThenBy(t => t.TaskType))
            {
                <tr>
                    <td class="mono">@type.TaskType</td>
                    <td>@type.DisplayName</td>
                    <td class="mono">@type.Assembly.GetName().Name</td>
                    <td>@type.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<TaskTypeInfo> _types = [];

    private IReadOnlyList<ModuleMenuItem> MenuItemsOf(string moduleName) =>
        ModuleList.FirstOrDefault(m => m.Name == moduleName)?.MenuItems ?? [];

    protected override async Task OnInitializedAsync() =>
        _types = (await GetTaskTypes.HandleAsync(new GetTaskTypesQuery())).Value ?? [];
}
