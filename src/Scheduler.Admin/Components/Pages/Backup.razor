@page "/backup"
@using Scheduler.Application.Backup
@inject IQueryHandler<GetBackupsQuery, BackupOverview> GetBackups
@inject ICommandHandler<CreateBackupCommand, BackupSetInfo> CreateBackup
@inject ICommandHandler<RestoreBackupCommand, RestoreResult> RestoreBackup
@inject IFolderPicker FolderPicker
@inject ToastService Toasts
@inject NavigationManager Navigation

<div class="page-header">
    <h1>Backup and restore</h1>
    <button class="btn btn-primary" @onclick="BackUpAsync" disabled="@(_busy is not null || _overview?.Tools.Found != true || _selected.Count == 0)">
        @(_busy == "backup" ? "Backing up…" : "Back up now")
    </button>
</div>

<ErrorBanner Result="_failed" />

@if (_overview is { } o)
{
    <p class="muted">
        A backup is a set: one PostgreSQL backup file per database, each checked after it is written and recorded with a checksum.
        The Database Backup task makes a set of all databases every night at 01:00. The newest @o.RetentionCount sets are kept;
        safety sets made before a restore or an upgrade are kept for seven days.
    </p>

    @if (!o.Tools.Found)
    {
        <div class="banner banner-error" role="alert">@o.Tools.Error <a href="configuration">Open Configuration</a></div>
    }
    else
    {
        <p class="hint">PostgreSQL tools: <span class="mono">@o.Tools.Folder</span></p>
    }

    <div class="card">
        <h2>What to back up</h2>
        <div class="toolbar">
            @foreach (var name in o.KnownDatabases)
            {
                <label class="checkbox">
                    <input type="checkbox" checked="@_selected.Contains(name)" @onchange="e => Toggle(_selected, name, e.Value is true)" />
                    <span class="mono">@name</span> <span class="hint">@DatabaseHint(name)</span>
                </label>
            }
        </div>
        @if (_selected.Count == 0)
        {
            <div class="field-error">Select at least one database.</div>
        }

        <div class="toolbar">
            <div class="field" style="flex:1">
                <label for="backup-folder">Folder</label>
                <input id="backup-folder" @bind="_folder" placeholder="@o.DefaultFolder" />
            </div>
            @if (FolderPicker.IsSupported)
            {
                <button class="btn" @onclick="BrowseAsync" disabled="@(_busy is not null)">Browse…</button>
            }
            <button class="btn" @onclick="LoadAsync" disabled="@(_busy is not null)">Show backups in this folder</button>
        </div>
        <p class="hint">
            Leave the folder empty for the default folder (@o.DefaultFolder).
            @if (o.CopyFolder is { } copy)
            {
                @: Every verified set is also copied to <span class="mono">@copy</span>.
            }
            else
            {
                @: Set a copy folder on the Configuration page to keep a second copy, for example on an external drive.
            }
        </p>
    </div>

    <div class="card table-wrap">
        <h2>Backups in <span class="mono">@o.Folder</span></h2>
        @if (o.Backups.Count == 0)
        {
            <p>There are no backups in this folder yet. Select Back up now to make the first one.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Set</th><th>Made</th><th>Kind</th><th>Databases</th><th class="num">Size</th><th>Checked</th><th></th></tr></thead>
                <tbody>
                    @foreach (var set in o.Backups)
                    {
                        <tr>
                            <td class="mono">@set.SetName</td>
                            <td>@Display.Time(set.CreatedAtUtc)</td>
                            <td>@Display.Words(set.Kind)</td>
                            <td>@string.Join(", ", set.Databases)</td>
                            <td class="num">@Display.Bytes(set.SizeBytes)</td>
                            <td>
                                @if (set.Verified)
                                {
                                    <StatusBadge Text="Verified" Tone="success" />
                                }
                                else
                                {
                                    <StatusBadge Text="Not verified" Tone="danger" Title="@set.FirstUnverified?.Error" />
                                }
                            </td>
                            <td class="row-actions">
                                <button class="btn btn-small" disabled="@(_busy is not null || !set.Verified)" @onclick="() => StartRestore(set)">Restore…</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else if (_failed is null)
{
    <p class="muted">Loading…</p>
}

@* A restore replaces whole databases, so it needs the typed word RESTORE (FR-72). *@
<ConfirmDialog Visible="_restoring is not null" Title="Restore from this backup?" ConfirmText="Restore" RequiredWord="@RestoreBackupCommand.ConfirmationWord"
               Busy="@(_busy == "restore")" Confirmed="RestoreAsync" Cancelled="() => _restoring = null">
    <p>The backup <span class="mono">@_restoring?.SetName</span> from @Display.Time(_restoring?.CreatedAtUtc) replaces the databases you select.
        Changes made to them since then are lost.</p>
    <div class="field">
        @foreach (var name in _restoring?.Databases ?? [])
        {
            <label class="checkbox">
                <input type="checkbox" checked="@_restoreSelected.Contains(name)" disabled="@(_busy == "restore")"
                       @onchange="e => Toggle(_restoreSelected, name, e.Value is true)" />
                <span class="mono">@name</span> <span class="hint">@DatabaseHint(name)</span>
            </label>
        }
    </div>
    @if (_restoreSelected.Count == 0)
    {
        <div class="field-error">Select at least one database to restore.</div>
    }
    <p>Before restoring, the files are checked, the engine is paused and a safety backup of the selected databases is made. Each database is
        restored in one step, so a database that fails to restore is left unchanged. Stop the Maintenance Agent before restoring maintenance_demo.
        After restoring the scheduler database you are signed out.</p>
    @if (_busy == "restore")
    {
        <p><strong>Restoring… this can take a few minutes.</strong></p>
    }
</ConfirmDialog>

@code {
    private BackupOverview? _overview;
    private Result? _failed;
    private string? _busy;
    private string? _folder;
    private HashSet<string> _selected = [];
    private BackupSetInfo? _restoring;
    private HashSet<string> _restoreSelected = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _selected = [.. _overview?.KnownDatabases ?? []];
    }

    private string? Folder => string.IsNullOrWhiteSpace(_folder) ? null : _folder.Trim();

    private async Task LoadAsync()
    {
        var result = await GetBackups.HandleAsync(new GetBackupsQuery(Folder));
        _failed = result.IsFailure ? result : null;
        _overview = result.Value ?? _overview;
    }

    private static void Toggle(HashSet<string> set, string name, bool on)
    {
        if (on)
        {
            set.Add(name);
        }
        else
        {
            set.Remove(name);
        }
    }

    private static string DatabaseHint(string name) => name switch
    {
        "inventory_demo" => "(Inventory Monitor)",
        "maintenance_demo" => "(Maintenance Agent)",
        _ => "(scheduler)"
    };

    private async Task BrowseAsync()
    {
        if (await FolderPicker.PickFolderAsync() is { } folder)
        {
            _folder = folder;
            await LoadAsync();
        }
    }

    private async Task BackUpAsync()
    {
        _busy = "backup";
        try
        {
            var databases = _overview!.KnownDatabases.Where(_selected.Contains).ToList();
            var result = await CreateBackup.HandleAsync(new CreateBackupCommand(databases, Folder));
            if (result.IsFailure)
            {
                Toasts.Error(result.Error!.Message);
            }
            else if (result.Value is { Verified: false } unverified)
            {
                // F-09: say "verified" only when every file was verified.
                Toasts.Warning($"Backup made but could not be verified: {unverified.FirstUnverified?.FileName}. Do not rely on this backup.");
            }
            else
            {
                var set = result.Value!;
                Toasts.Success($"Backup made and verified: {set.SetName} ({string.Join(", ", set.Databases)}, {Display.Bytes(set.SizeBytes)}).");
            }

            foreach (var warning in result.Value?.Warnings ?? [])
            {
                Toasts.Warning(warning);
            }

            await LoadAsync();
        }
        finally
        {
            _busy = null;
        }
    }

    private void StartRestore(BackupSetInfo set)
    {
        _restoring = set;
        _restoreSelected = [.. set.Databases];
    }

    private async Task RestoreAsync(string typed)
    {
        var set = _restoring!;
        if (_restoreSelected.Count == 0)
        {
            return;
        }

        _busy = "restore";
        try
        {
            var databases = set.Databases.Where(_restoreSelected.Contains).ToList();
            var result = await RestoreBackup.HandleAsync(new RestoreBackupCommand(set.SetName, databases, typed, Folder));
            _restoring = null;
            if (result.IsFailure)
            {
                Toasts.Error(result.Error!.Message);
                await LoadAsync();
                return;
            }

            var restored = result.Value!;
            Toasts.Success($"Restored {string.Join(", ", restored.Restored)} from {set.SetName}. " +
                           (restored.EngineResumed ? "The engine has resumed." : "The engine was not running before, so it stays paused or stopped."));
            if (restored.SignedOut)
            {
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _busy = null;
        }
    }
}
