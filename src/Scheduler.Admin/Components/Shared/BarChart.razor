@using Scheduler.Application.Reports
@* A grouped bar chart drawn as SVG, so it needs no script library and prints well (FR-56, FR-65). *@
@if (Chart is null || Chart.Labels.Count == 0)
{
    <p class="muted">No data for this period.</p>
}
else
{
    <svg class="chart" viewBox="0 0 @Width @Height" role="img" aria-label="@Chart.Title">
        <title>@Chart.Title</title>
        @for (var tick = 0; tick <= 4; tick++)
        {
            var value = Max * tick / 4;
            var y = Y(value);
            <g>
                <line class="axis" x1="@Left" x2="@(Width - 4)" y1="@F(y)" y2="@F(y)" />
                <text x="@(Left - 4)" y="@F(y + 3)" text-anchor="end">@FormatValue(value)</text>
            </g>
        }
        @for (var i = 0; i < Chart.Labels.Count; i++)
        {
            var groupX = Left + i * GroupWidth;
            <g>
            @for (var s = 0; s < Chart.Series.Count; s++)
            {
                var series = Chart.Series[s];
                var value = i < series.Values.Count ? series.Values[i] : 0;
                var barX = groupX + GroupWidth * 0.1 + s * BarWidth;
                <rect class="@series.CssClass" x="@F(barX)" y="@F(Y(value))" width="@F(Math.Max(1, BarWidth - 1))" height="@F(Bottom - Y(value))">
                    <title>@Chart.Labels[i] · @series.Name: @FormatValue(value)</title>
                </rect>
            }
            <text x="@F(groupX + GroupWidth / 2)" y="@(Height - 6)" text-anchor="middle">@(ShowLabel(i) ? Shorten(Chart.Labels[i]) : "")</text>
            </g>
        }
    </svg>
    <div class="legend">
        @foreach (var series in Chart.Series)
        {
            <span class="@series.CssClass">@series.Name</span>
        }
    </div>
}

@code {
    private const double Width = 640, Height = 240, Left = 44, Bottom = Height - 22, Top = 8;

    [Parameter] public ReportChart? Chart { get; set; }

    [Parameter] public Func<double, string>? Format { get; set; }

    // Counts get whole-number gridlines: the top of the scale is a multiple of four.
    private double Max
    {
        get
        {
            var values = Chart!.Series.SelectMany(s => s.Values).DefaultIfEmpty(0).ToList();
            var max = NiceMax(values.Max());
            return values.All(v => v == Math.Floor(v)) ? Math.Max(4, Math.Ceiling(max / 4) * 4) : max;
        }
    }

    private double GroupWidth => (Width - Left - 4) / Chart!.Labels.Count;

    private double BarWidth => GroupWidth * 0.8 / Math.Max(1, Chart!.Series.Count);

    private double Y(double value) => Bottom - (Bottom - Top) * (Max <= 0 ? 0 : value / Max);

    private bool ShowLabel(int i) => Chart!.Labels.Count <= 12 || i % (int)Math.Ceiling(Chart.Labels.Count / 12.0) == 0;

    private string FormatValue(double value) => Format?.Invoke(value) ?? value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Shorten(string label) => label.Length > 14 ? label[..13] + "…" : label;

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    internal static double NiceMax(double max)
    {
        if (max <= 0)
        {
            return 1;
        }

        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(max)));
        var step = new[] { 1, 2, 2.5, 5, 10 }.First(s => s * magnitude >= max / 1.0001 || s == 10);
        return step * magnitude;
    }
}
