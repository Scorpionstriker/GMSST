@implements IDisposable
@inject ToastService Service

<div class="toasts no-print" aria-live="polite">
    @foreach (var toast in Service.Toasts)
    {
        <div class="toast @(toast.Kind switch { ToastKind.Error => "error", ToastKind.Warning => "warning", _ => "" })" role="@(toast.Kind == ToastKind.Success ? "status" : "alert")" @onclick="() => Service.Dismiss(toast.Id)">
            @toast.Message
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Service.Changed -= OnChanged;
}
