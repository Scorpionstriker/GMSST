@* One colour per meaning across every page (NFR-01): green success, red failure, amber attention, blue in progress. *@
<span class="badge @CssClass" title="@Title">@(Text ?? (Value is null ? Display.Empty : Display.Words(Value)))</span>

@code {
    [Parameter] public Enum? Value { get; set; }

    /// <summary>Overrides the text, for example "Deleted".</summary>
    [Parameter] public string? Text { get; set; }

    [Parameter] public string? Tone { get; set; }

    /// <summary>Tooltip text, for example why a task will not run.</summary>
    [Parameter] public string? Title { get; set; }

    private string CssClass => "badge-" + (Tone ?? ToneOf(Value));

    public static string ToneOf(Enum? value) => value is ExecutionStatus.Running ? "info" : value?.ToString() switch
    {
        "Success" or "Active" or "Processed" or "Running" or "Idle" => "success",
        "Failed" or "TimedOut" or "Stopped" => "danger",
        "Retrying" or "Paused" or "Claimed" or "Busy" => "warning",
        "Waiting" => "info",
        _ => "muted"
    };
}
