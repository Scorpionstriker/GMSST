@typeparam TColumn where TColumn : struct, Enum

<button type="button" @onclick="() => Sort.InvokeAsync(Column)" aria-label="Sort by @Title">
    @Title @(EqualityComparer<TColumn>.Default.Equals(Current, Column) ? (Descending ? "▼" : "▲") : "")
</button>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public TColumn Column { get; set; }
    [Parameter] public TColumn Current { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback<TColumn> Sort { get; set; }
}
