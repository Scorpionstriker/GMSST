@using System.Globalization
@* A date-only field shown and typed as dd/mm/yy, whatever the computer's regional format. The browser's own date
   field would follow the regional format and show a yyyy/mm/dd --:-- mask, so a plain text field is used, with an
   invisible native date picker over the calendar icon for choosing a date with the mouse. Only the date is kept; the
   page decides which time of day it stands for (for example the start or the end of that day in a filter). *@

<div class="date-field">
    <div class="date-field-box">
        <input id="@Id" type="text" inputmode="numeric" autocomplete="off" maxlength="10" placeholder="@Placeholder"
               title="Type a date as dd/mm/yy, or choose one with the calendar." value="@_text" @onchange="OnTypedAsync"
               class="@(_invalid ? "invalid" : "")" aria-invalid="@(_invalid ? "true" : "false")" />
        <span class="date-field-picker" title="Choose a date">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
                <rect x="1.5" y="3" width="13" height="11.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
                <path d="M1.5 6.5h13M5 1.5v3M11 1.5v3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <input type="date" tabindex="-1" aria-hidden="true" value="@Value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnPickedAsync" />
        </span>
    </div>
    @if (_invalid)
    {
        <span class="field-error" role="alert">Use dd/mm/yy, for example 30/10/26.</span>
    }
</div>

@code {
    public const string Format = "dd/MM/yy";

    private static readonly string[] InputFormats = ["d/M/yy", "d/M/yyyy"];

    [Parameter] public string? Id { get; set; }
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "dd/mm/yy";

    private string _text = "";
    private bool _invalid;
    private DateTime? _shown;

    protected override void OnParametersSet()
    {
        // Show a value set by the page (for example a default range), but keep a wrong entry on screen for correcting.
        if (Value?.Date != _shown?.Date || (Value is null && !_invalid))
        {
            _shown = Value?.Date;
            _text = Show(Value);
            _invalid = false;
        }
    }

    /// <summary>The date as the field shows it, for example "30/10/26".</summary>
    public static string Show(DateTime? value) => value?.ToString(Format, CultureInfo.InvariantCulture) ?? "";

    /// <summary>Reads dd/mm/yy or dd/mm/yyyy; "-" and "." work as separators too. Empty text is no date.</summary>
    public static bool TryRead(string? text, out DateTime? value)
    {
        value = null;
        var trimmed = (text ?? "").Trim().Replace('-', '/').Replace('.', '/');
        if (trimmed.Length == 0)
        {
            return true;
        }

        if (DateTime.TryParseExact(trimmed, InputFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            value = date.Date;
            return true;
        }

        return false;
    }

    private async Task OnTypedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        if (!TryRead(text, out var value))
        {
            _text = text;
            _invalid = true;
            return;
        }

        await SetAsync(value);
    }

    private async Task OnPickedAsync(ChangeEventArgs e)
    {
        var picked = DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : (DateTime?)null;
        await SetAsync(picked);
    }

    private async Task SetAsync(DateTime? value)
    {
        _invalid = false;
        _shown = value;
        _text = Show(value);
        await ValueChanged.InvokeAsync(value);
    }
}
