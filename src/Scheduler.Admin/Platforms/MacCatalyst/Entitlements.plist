<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.-->
    <dict>
        <!-- The scheduler is a local tool, not an App Store app: it runs pg_dump and pg_restore for backups (FR-67)
             and writes to its own folders, which the App Sandbox would block. Enable the sandbox only if the
             app is ever distributed through the Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <false/>
        <!-- When App Sandbox is enabled, this value is required to open outgoing network connections. -->
        <key>com.apple.security.network.client</key>
        <true/>
    </dict>
</plist>

