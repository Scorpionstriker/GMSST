<Project Sdk="Microsoft.NET.Sdk">

  <!-- Demonstration app 2: a headless console application that embeds the scheduler core, runs its own
       engine against the shared database and handles HealthCheck and TempFileCleanup tasks. Runs on
       Windows, macOS and Linux (FR-79, NFR-10). References Engine, Infrastructure and Extensibility. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DemoApps.MaintenanceAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scheduler.Engine\Scheduler.Engine.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Infrastructure\Scheduler.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Scheduler.Extensibility\Scheduler.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
