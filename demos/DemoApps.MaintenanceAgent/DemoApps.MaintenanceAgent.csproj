<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Demonstration app 2 (FR-79, WP-1): a separate application with its own database maintenance_demo and no
       scheduling engine. It offers a small HTTP API on the loopback address only (127.0.0.1 and [::1], port 5087),
       which the scheduler calls with the built-in Local HTTP Request task type. It references no scheduler
       project, so it is fully independent. Runs on Windows, macOS and Linux (NFR-10). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DemoApps.MaintenanceAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.UnitTests" />
  </ItemGroup>

</Project>
